

# Autostart apps when Hyprland launches
exec-once = waybar
exec-once = dunst &
exec-once = nm-applet
exec-once = blueman-applet &
exec-once = /usr/bin/gnome-keyring-daemon --start --components=secrets,pkcs11,ssh
exec-once = brave --password-store=gnome
exec-once = cliphist store
exec-once = hyprctl reload
exec-once = hyprpaper
#exec = mpvpaper '*' /home/tanmay/Downloads/mark.mp4 -o "--loop --mute --vo=libmpv --hwdec=no"




























bind=SUPER,SPACE,exec,rofi -show drun -theme ~/.config/rofi/launchers/type-5/style-5.rasi

bind =, ESCAPE, killactive

# SUPER + T -> Terminal (Alacritty)
bind = SUPER, T, exec, alacritty

# SUPER + E -> Dolphin File Manager
bind = SUPER, E, exec, dolphin

# SUPER + B -> Brave Browser
bind = SUPER, B, exec, brave

# SUPER + V -> VSCode
bind = SUPER, V, exec, code

# SUPER + S -> System Settings (assuming plasma systemsettings)
bind = SUPER, S, exec, systemsettings

# SUPER + M -> System Monitor (let's use btop — looks sexy; or ksysguard/plasma-systemmonitor)
bind=SUPER,M,exec,alacritty -e btop



# Brightness down
bind=,XF86MonBrightnessDown,exec,brightnessctl -d intel_backlight s 5%- && notify-send "Brightness Down"

# Brightness up
bind=,XF86MonBrightnessUp,exec,brightnessctl -d intel_backlight s 5%+ && notify-send "Brightness Up"

# Volume down
bind=,XF86AudioLowerVolume,exec,pactl set-sink-volume @DEFAULT_SINK@ -5% && notify-send "Volume" "$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}')"

# Volume up
bind=,XF86AudioRaiseVolume,exec,pactl set-sink-volume @DEFAULT_SINK@ +5% && notify-send "Volume" "$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}')"

# Mute toggle
bind=,XF86AudioMute,exec,pactl set-sink-mute @DEFAULT_SINK@ toggle && notify-send "Mute" "$(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}')"




# Other configs above...


general {
    gaps_in = 10
    gaps_out = 15
    border_size = 3
    col.active_border = rgba(a6e3a1ee)  # soft green border (active)
    col.inactive_border = rgba(313244aa) # faded gray border
    resize_on_border = true
    layout = master

    # Performance tuning
    extend_border_grab_area = 15
}

decoration {
    rounding = 20  # smooth rounded corners
}

animations {
    enabled = yes
    bezier = easeinout, 0.25, 0.1, 0.25, 1
    animation = windows, 1, 7, easeinout
    animation = fade, 1, 4, easeinout
    animation = workspaces, 1, 6, easeinout

    # Extra smooth pop
    animation = border, 1, 5, easeinout
    animation = fadeDim, 1, 3, easeinout
}

dwindle {
    preserve_split = yes
    smart_split = yes
    smart_resizing = yes
}

misc {
    focus_on_activate = true
    mouse_move_enables_dpms = true
    vfr = true  # reduces tearing
    disable_hyprland_logo = true
    animate_manual_resizes = true
}


gestures {
    workspace_swipe = on
}



#scalling

monitor=eDP-1,preferred,0x0,1





# Reverse scroll (natural scrolling)

device {

name = syna2ba6:00-06cb:ce2d-mouse

natural_scroll = true

}

device {

name = syna2ba6:00-06cb:ce2d-touchpad

natural_scroll = true

}
